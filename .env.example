# Anthropic API anahtarı (https://console.anthropic.com)
# Boş bırakılırsa ücretsiz çeviri (Google Translate) kullanılır
ANTHROPIC_API_KEY=

# Çeviri yöntemi: auto (anahtar varsa Claude, yoksa ücretsiz) | claude | free
TRANSLATOR=auto

# Ücretsiz çeviri sırası: LibreTranslate (ayarlıysa) → Google → MyMemory
# E-posta yazarsanız MyMemory günlük sınırı 5.000'den 50.000 karaktere çıkar
MYMEMORY_EMAIL=
# Kendi LibreTranslate sunucunuz (sınırsız). "docker compose --profile ceviri up" ile açıp şunu yazın:
# LIBRETRANSLATE_URL=http://libretranslate:5000
LIBRETRANSLATE_URL=

# Yönetim paneli şifresi — mutlaka değiştirin
ADMIN_PASSWORD=degistir-beni

# Aylık toplam bütçe ve sunucuya ayrılan pay (EUR)
MONTHLY_BUDGET_EUR=50
SERVER_COST_EUR=10
USD_TO_EUR=0.92

# Otomatik tarama aralığı (dakika)
SCAN_INTERVAL_MINUTES=60

# Hızlı geliştirme modu (kod değişiklikleri yeniden derlemeden görünür). Açmak için başındaki # işaretini kaldırın:
# COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml
